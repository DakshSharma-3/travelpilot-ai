# Server-side only. Read by src/travel/services/geocodeFn.ts for destination
# lookup via the Geoapify Geocoding API. Get a free key at https://www.geoapify.com
# Never prefix with VITE_ — that would expose it in the browser bundle.
# Copy to .env.local (dev) or set in your deployment's environment settings.
GEOAPIFY_API_KEY=
